# Environment Variables Configuration
# Masukkan nilai ini ke Netlify Dashboard (Site configuration -> Environment variables)
# Atau salin ke .env.local untuk development lokal

# Nomor WhatsApp penerima (format internasional tanpa '+', contoh: 6281234567890)
#
# Dibaca HANYA di sisi server, oleh netlify/functions/wa.mts. Sengaja tanpa
# awalan NEXT_PUBLIC_ supaya Next.js nggak ikut nyelipin nilainya ke bundle
# browser. Tombol WhatsApp di halaman nunjuk ke /go/wa, dan perantara itu yang
# nyusun URL wa.me-nya.
#
# Konsekuensinya: tombol WhatsApp nggak jalan di `next dev` biasa, karena
# Netlify Function cuma hidup waktu dideploy atau waktu dijalanin lewat
# `npx netlify dev`.
WHATSAPP_PHONE=

# Email penerima draft konsultasi.
# Yang ini memang perlu dibaca browser, jadi wajar kalau ikut ke bundle.
NEXT_PUBLIC_CONTACT_EMAIL=
